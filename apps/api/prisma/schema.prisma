// PostgreSQL in every environment (migrations use Postgres SQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// App user — created via local JWT auth or Supabase (cloud).
// supabaseId is null for local auth users.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String? // null for Supabase auth users
  supabaseId   String? @unique // null for local auth users
  avatarUrl    String?
  timezone     String  @default("UTC")

  emailVerified Boolean @default(false)
  // Two-step verification (an authenticator app). totpSecret is encrypted; it counts only once totpEnabledAt is set.
  // totpLastStep is the newest 30-second step already accepted, so a code cannot be used twice. lib/totp.ts
  totpSecret    String?
  totpEnabledAt DateTime?
  totpLastStep  Int?
  // "Send me tips & product updates" on the sign-up form. Unchecked or social sign-up = false.
  marketingOptIn Boolean @default(false)

  // Onboarding email tracking — prevent duplicate sends
  day3NudgeSentAt    DateTime?
  day7NudgeSentAt    DateTime?
  expiryNudgeSentAt  DateTime?
  day14WinbackSentAt DateTime?

  // Active workspace — which workspace is currently selected for this user
  activeWorkspaceId String?
  activeWorkspace   Workspace? @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id])

  accounts           Account[]
  postJobs           PostJob[]
  reviewedJobs       PostJob[]           @relation("PostJobReviewedBy")
  submittedJobs      PostJob[]           @relation("PostJobSubmittedBy")
  designRequestsAssigned DesignRequest[] @relation("DesignRequestAssignee")
  designRequestsCreated  DesignRequest[] @relation("DesignRequestCreatedBy")
  notifications      Notification[]      @relation("NotificationRecipient")
  notificationsCaused Notification[]     @relation("NotificationActor")
  loginEvents       LoginEvent[]
  recoveryCodes      RecoveryCode[]
  totpChallenges     TotpChallenge[]
  authSessions       AuthSession[]
  apiKeys            ApiKey[]
  emailVerifications EmailVerification[]
  templates          Template[]
  sessions           Session[]
  events             Event[]
  workspaceMembers   WorkspaceMember[]
  feedbacks          Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A workspace — the billing and collaboration unit.
// Every user gets a personal workspace on register.
// Team plan allows multiple members.
model Workspace {
  id   String @id @default(cuid())
  name String

  // Billing (moved from User)
  plan             String    @default("trialing") // trialing | creator | pro | team | cancelled
  planStatus       String    @default("trialing") // trialing | active | cancelled
  trialEndsAt      DateTime?
  dodoCustomerId   String?   @unique
  dodoSubId        String?   @unique
  allowTrial       Boolean   @default(true) // false after first trial used (abuse prevention)
  allowReels       Boolean   @default(true) // Instagram Reels & Stories (Pro/Team only; default true so existing workspaces keep access)
  allowOverrides   Boolean   @default(true) // per-platform text/comment overrides (Pro/Team only; default true so existing workspaces keep access)
  approvalRequired Boolean   @default(false) // member posts must be approved by owner/admin/designer before scheduling

  webhookUrl String? // outbound webhook fired on post publish

  // Per-workspace overrides — set by admin to give a specific workspace higher limits than their plan
  customMaxLibraries    Int? // overrides plan.maxLibraries when set
  customMaxDripPerDay   Int? // overrides plan.maxDripPerDay when set
  customMaxLibraryItems Int? // overrides plan.maxLibraryItems when set

  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  accounts         Account[]
  postJobs         PostJob[]
  templates        Template[]
  apiKeys          ApiKey[]
  feedbacks        Feedback[]
  contentLibraries ContentLibrary[]
  accountGroups    AccountGroup[]
  designAssets     DesignAsset[]
  designs          Design[]
  designSubmissions    DesignSubmission[]
  designReviewRequests DesignReviewRequest[]
  designRequests       DesignRequest[]
  notifications        Notification[]

  // Back-ref for users whose activeWorkspace points here
  activeForUsers User[] @relation("UserActiveWorkspace")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Membership link between User and Workspace.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner | admin | designer | member
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

// Email invite to join a workspace — 7-day TTL, single-use.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([workspaceId])
}

// Server-side login session (local auth). `id` is the `sid` claim in the access JWT.
// The refresh token is opaque; only its sha256 is stored. Rotated on every use;
// the previous hash is kept for a short grace window. `expiresAt` is the absolute
// limit and is never extended. Policy numbers: src/lib/auth/sessionPolicy.ts.
model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  prevTokenHash String?   @unique
  rotatedAt     DateTime?
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  // The browser it was opened from (the User-Agent header, cut to 300 characters); null for sessions that predate this.
  userAgent     String?

  @@index([userId])
}

// One-time codes for a person who has lost their phone. Only a hash is kept; a code is shown once, when it is made.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A login that has the right password and is waiting for its code: 5 minutes, 5 wrong codes. Only the token's hash is kept.
model TotpChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  remember  Boolean  @default(true)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A sign-in, or a wrong password on a real account: "Recent sign-ins" on the profile page. Kept 30 days. No IP address.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  userAgent String?
  success   Boolean
  failure   String? // "Wrong password"; null when it worked

  @@index([userId, at])
}

// A connected social media account for a specific platform.
model Account {
  id             String    @id @default(cuid())
  platform       String // "bluesky" | "threads" | "linkedin"
  displayName    String
  credentials    String // AES-256-GCM encrypted JSON, never plaintext
  avatarUrl      String?
  refreshToken   String?
  expiresAt      DateTime?
  warnedExpiryAt DateTime? // set when expiry warning email was sent (prevents re-sending)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  targets      PostJobTarget[]
  groupMembers AccountGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, platform])
}

// A scheduled post job.
model PostJob {
  id           String    @id @default(cuid())
  scheduledFor DateTime?
  status       String    @default("pending")
  content      String
  commentText  String?
  dryRun       Boolean   @default(false)

  // Design-team approval — only used when Workspace.approvalRequired is on.
  // null = approval not required / plain user draft.
  // "pending" = waiting for review (status stays "draft", never enqueued)
  // "approved" = approved and promoted to pending
  // "rejected" = reviewer sent it back with reviewNote
  approvalStatus   String?
  reviewNote       String?
  reviewedByUserId String?
  reviewedBy       User?     @relation("PostJobReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  // Last time the post was sent for review, by whom, and how many times (1 = first). lib/submitStamp.ts
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("PostJobSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submitCount   Int       @default(0)

  // Content-plan import idempotency — hash of title + date + platforms.
  importKey String?

  // Repeat / evergreen
  repeatInterval String? // "daily" | "weekly" | "monthly"
  repeatEndsAt   DateTime? // stop spawning after this date (inclusive)
  repeatParentId String? // ID of the first job in the chain (flat reference)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  targets       PostJobTarget[]
  designRequest DesignRequest?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, scheduledFor, id])
  @@index([workspaceId, approvalStatus])
  @@index([workspaceId, submittedAt])
  @@index([repeatParentId])
  @@unique([workspaceId, importKey])
}

// One row per (PostJob × Account).
model PostJobTarget {
  id String @id @default(cuid())

  postJob   PostJob @relation(fields: [postJobId], references: [id], onDelete: Cascade)
  postJobId String

  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountId String

  status         String  @default("pending")
  platformPostId String?
  replyContext   String?
  error          String?
  attempts       Int     @default(0)

  stats PostStats?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([postJobId])
  @@index([accountId])
  @@index([accountId, status])
  @@index([platformPostId])
}

// Cached engagement stats per PostJobTarget — synced every 6h by statsCron.
model PostStats {
  id       String @id @default(cuid())
  targetId String @unique

  target PostJobTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  likes   Int  @default(0)
  reposts Int  @default(0)
  replies Int  @default(0)
  views   Int?

  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
}

// Email verification token — single-use, 24-hour TTL.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  // The address the link/code was mailed to. Verifying only counts while it is still the user's email.
  // Null on rows created before this column existed.
  email     String?
  // sha256(token:code) of the 6-digit code mailed with the link. Null on rows created before codes existed.
  codeHash  String?
  // Wrong code guesses so far. The code is dead after MAX_CODE_ATTEMPTS.
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// Password reset token — single-use, 1-hour TTL.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// Tracks uploaded media files so orphans can be cleaned up.
model Upload {
  id        String    @id @default(cuid())
  url       String    @unique
  userId    String
  claimedAt DateTime? // set when a PostJob references this file
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([claimedAt, createdAt])
}

// Short-lived nonce for OAuth CSRF protection.
model OAuthState {
  id        String   @id @default(cuid())
  userId    String
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([nonce])
}

// API key for programmatic access (Pro/Team plans, or all users when billing disabled).
model ApiKey {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // human label e.g. "My Claude agent"
  keyHash     String     @unique // SHA-256 hash of the raw key
  prefix      String // first 12 chars shown in UI e.g. "ph_abc12345"
  lastUsedAt  DateTime?
  revokedAt   DateTime? // null = active
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([keyHash])
}

// Design template — the reference design for one content type (docs/content-types.md).
// One per workspace + category; never copied into a post.
model Template {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // derived from category
  pillar      String? // derived from category; null for Ask Me Anything
  category    String? // one of CATEGORIES; becomes required once legacy rows are cleaned up
  linkUrl     String? // Figma link to the design
  previewUrl  String? // optional preview image, shown in the library and compose only
  published   Boolean    @default(false) // Draft until the design team publishes it: only published templates reach Marketing
  format      String? // carousel | single | reel_cover | story | video (lib/templateBody.ts)
  slides      Int? // number of slides, carousel only
  platforms   String[]   @default([]) // instagram | linkedin
  // One image per slide of a carousel (an Upload row each), and its short name ("" when it has none): the same length.
  // Read and written only through slideImages in lib/templates.ts.
  slideUrls   String[]   @default([])
  slideLabels String[]   @default([])
  captionGuideline String? // what a caption for this kind of post should do; shown to Marketing, never copied into a post
  content     String     @default("{}") // DEPRECATED: legacy template-kit JSON, no longer written
  // The Canvas design this template is made in (a template may have this, a Figma link, or both). One design belongs to at
  // most one template (unique). NO ACTION, not SET NULL: a linked design cannot be deleted from under a published
  // template, but deleting a workspace (which cascades to both rows) still works.
  designId    String?    @unique
  design      Design?    @relation(fields: [designId], references: [id], onDelete: NoAction)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([previewUrl])
}

// Media files of legacy template kits. Posts made from a kit share these files,
// so post cleanup must never delete them, even after the kit itself is gone.
model LegacyTemplateMedia {
  url       String   @id
  createdAt DateTime @default(now())
}

// An image a Canvas design uses (PNG, or an SVG rasterized to PNG). Delivered only through the
// authenticated /canvas/assets/:id/content route; storageRef never leaves the server.
model DesignAsset {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storageRef      String    @unique // private storage path, never serialized to the client
  width           Int
  height          Int
  bytes           Int
  sourceFormat    String // png | svg
  createdByUserId String? // no FK: deleting a user must not delete workspace assets
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
}

// A Canvas design, of one of two kinds (the CHECK constraint Design_shape_check, in the migration, pins each shape):
//  - "template": the designer's working copy. `document` is a CanvasDocument (apps/api/src/lib/canvas.ts validates it on
//    every save) and is never null; baseRevisionId and overrides are null.
//  - "instance" (phase 5): what one Marketing person made from a published template. It has NO document of its own: it
//    pins one exact, immutable DesignRevision (`baseRevisionId`, never changed: a trigger refuses it) and stores only
//    `overrides`, the text and images that revision's manifest lets Marketing change. The effective document is the
//    revision's document plus the overrides, composed in memory when it is drawn; it is never stored.
// `version` is the optimistic lock: a save names the version it was based on and only succeeds while that is still the
// stored one.
model Design {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind            String // template | instance
  name            String
  document        Json? // null for kind = "instance"
  overrides       Json? // instances only: { schemaVersion: 1, fields: [{ nodeId, text } | { nodeId, assetId }] }
  baseRevisionId  String? // instances only: the revision this one was made from. NO ACTION: a design with instances cannot be deleted
  baseRevision    DesignRevision? @relation("InstanceBase", fields: [baseRevisionId], references: [id], onDelete: NoAction)
  version         Int       @default(1)
  createdByUserId String? // no FK: deleting a user must not delete workspace designs. An instance belongs to this user alone
  // Phase 6, instances only: set when the person archives a design that has been submitted for review (a submitted
  // design is never hard-deleted). Once set the row never changes again (trigger Design_archived_frozen).
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revisions       DesignRevision[] @relation("DesignRevisions")
  template        Template?
  submissions     DesignSubmission[] @relation("InstanceSubmissions") // NO ACTION on that side: an instance with a submission cannot be deleted

  @@index([workspaceId, kind, updatedAt])
  // "My designs": createdAt (never updatedAt, which every autosave changes) then id, the exact order of the keyset
  // pagination, so the list is one index scan with no sort.
  @@index([workspaceId, kind, createdByUserId, createdAt, id])
  @@index([baseRevisionId])
}

// A published, immutable revision of a Canvas design (phase 4). Rows are only ever inserted: triggers refuse an UPDATE and a
// direct DELETE (only the cascade from deleting an unlinked Design removes them). `document` is the design as it was
// published; `manifest` is the server-derived list of the layers Marketing may change (apps/api/src/lib/canvas.ts),
// stored with the revision so it can never drift from it. Published template revisions only: review snapshots (a later
// phase) get their own table.
model DesignRevision {
  id              String   @id @default(cuid())
  designId        String
  design          Design   @relation("DesignRevisions", fields: [designId], references: [id], onDelete: Cascade)
  instances       Design[] @relation("InstanceBase") // the Marketing designs made from this exact revision (phase 5)
  submissions     DesignSubmission[] @relation("SubmissionBase") // review snapshots made from it (phase 6)
  number          Int // 1, 2, 3 ... per design
  designVersion   Int // the Design.version it was published from: one revision per working version
  document        Json
  manifest        Json
  createdByUserId String? // no FK: deleting a user must not delete revisions
  createdAt       DateTime @default(now())

  @@unique([designId, number])
  @@unique([designId, designVersion])
}

// What one Marketing person submitted for review (phase 6). INSERT ONLY: triggers refuse any UPDATE and a direct DELETE (only
// the cascade from deleting a Workspace removes a row). `document` is the design as the SERVER composed it from the pinned
// revision and the overrides (never anything the client sent); `overrides` and `name` are what the review compares against.
// `instanceId` is NO ACTION: an instance with a submission can never be hard-deleted (it is archived instead), and so can
// the revision, through `baseRevisionId`. NEVER make either one CASCADE: a cascade runs at trigger depth 2, which the
// DELETE trigger allows, so it would quietly erase review history. User ids carry no foreign key (a SetNull would update
// an immutable row and break account deletion); the name is read from User when needed.
model DesignSubmission {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instanceId        String
  instance          Design         @relation("InstanceSubmissions", fields: [instanceId], references: [id], onDelete: NoAction)
  number            Int // 1, 2, 3 ... per instance
  instanceVersion   Int // the Design.version it was submitted from
  name              String
  note              String? // optional, up to 500 characters
  baseRevisionId    String
  baseRevision      DesignRevision @relation("SubmissionBase", fields: [baseRevisionId], references: [id], onDelete: NoAction)
  overrides         Json // { schemaVersion: 1, fields: [...] }, as the instance held them
  document          Json // the composed document
  submittedByUserId String // no FK
  createdAt         DateTime       @default(now())
  review            DesignReviewRequest?

  @@unique([instanceId, number])
  @@unique([instanceId, instanceVersion])
  @@index([baseRevisionId])
  @@index([workspaceId])
}

// The designer's answer to one submission (phase 6). It leaves "pending" exactly once, to approved, changes_requested or
// superseded (a newer submission replaced it), and never changes again (trigger). `pendingInstanceId` is set only while
// pending and is unique, so an instance has at most one pending review without a partial index (Prisma drops those); it has
// no foreign key on purpose (the submission's own foreign key already protects the instance).
model DesignReviewRequest {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissionId      String           @unique
  submission        DesignSubmission @relation(fields: [submissionId], references: [id], onDelete: NoAction)
  status            String // pending | approved | changes_requested | superseded
  pendingInstanceId String?          @unique
  comment           String? // up to 2000 characters; required for changes_requested
  decidedByUserId   String? // no FK
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([workspaceId, status, createdAt, id])
}

// Marketing's request to a designer for the design of one post (Path B of the Edit Content page): who, by when, and the
// brief. Not the Canvas DesignReviewRequest (that is a designer's answer to a Canvas submission). "draft" is a saved brief
// Marketing can still change; "sent" is locked until Marketing cancels it; "done" is the designer's answer (the Figma link),
// locked for both sides. The assignee is nullable so deleting a user keeps the brief; a designer who left the workspace stays
// here and the API reports them as no longer active.
model DesignRequest {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postJobId    String    @unique
  postJob      PostJob   @relation(fields: [postJobId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     User?     @relation("DesignRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deadline     DateTime? // optional; an instant (WIB wall clock in the UI), before the post's publishing time
  brief        String
  referenceUrl String?
  status       String    @default("draft") // draft | sent | done
  sentAt       DateTime?
  // The designer's side. figmaUrl + designerNote are the designer's own while "sent" (a saved draft, never shown to
  // Marketing) and the answer once "done"; Marketing and the public views read them only from a done request.
  figmaUrl      String?
  designerNote  String?
  doneAt        DateTime?
  revisionNote  String?
  history       Json      @default("[]")
  createdById  String?
  createdBy    User?     @relation("DesignRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, assigneeId, status])
}

// One line in a person's notification drawer. Only the facts are stored (who it is for, what happened, which post, who did
// it); the title, picture and note are read from the post when the drawer opens, so a renamed post is renamed here too.
// kind: task_assigned | task_cancelled | design_done | review_submitted | post_approved | post_sent_back | post_failed
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  postJobId   String?
  postJob     PostJob?  @relation(fields: [postJobId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, workspaceId, createdAt])
  @@index([userId, workspaceId, readAt])
}

// Anonymous + pre-login visitor session — one row per browser session.
// Updated as the visitor navigates; flushed on tab close or login.
model Session {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entry     String
  exit      String?
  pages     Json
  referrer  String?
  converted Boolean  @default(false)
  duration  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([userId])
  @@index([createdAt])
}

model Event {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

// In-app feedback / bug reports submitted via sidebar modal.
model Feedback {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId  String?
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  type         String // "bug" | "feature" | "general"
  message      String
  url          String? // page path the user was on
  unreadByUser Int             @default(0) // count of admin replies not yet seen by user
  createdAt    DateTime        @default(now())
  replies      FeedbackReply[]

  @@index([userId])
  @@index([createdAt])
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  sender     String // "admin" | "user"
  message    String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}

// Cancellation feedback submitted when a user cancels their subscription.
model CancellationFeedback {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  reason    String?
  feedback  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Account group — a named set of accounts for quick selection in compose.
model AccountGroup {
  id          String               @id @default(cuid())
  name        String
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     AccountGroupMember[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([workspaceId])
}

model AccountGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([groupId, accountId])
  @@index([groupId])
}

// Content Library — stores a collection of posts to drip-publish over time.
// Users upload CSV once; the drip cron picks items daily and creates PostJobs.
model ContentLibrary {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name   String
  status String @default("active") // "active" | "paused" | "exhausted"

  // Drip settings
  postsPerDay Int    @default(1) // how many items to publish per day (plan-capped)
  timeSlots   Json // String[] — "HH:MM" in user's timezone e.g. ["09:00","14:00"]
  timezone    String @default("UTC")
  accountIds  Json // String[] — account IDs to post to

  // Safety: track last drip run to avoid double-firing
  lastDripAt DateTime?

  items LibraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
}

// A single content item inside a ContentLibrary.
// status flow: queued → scheduled → published | skipped | failed
model LibraryItem {
  id        String         @id @default(cuid())
  libraryId String
  library   ContentLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  workspaceId String // denormalized for fast workspace-scoped queries

  // Content (mirrors PostJob content structure)
  text        String  @default("")
  commentText String?
  mediaUrls   Json    @default("[]") // String[]

  // Ordering — preserves CSV row order for drip sequence
  order Int

  // Lifecycle
  status         String  @default("queued") // "queued" | "scheduled" | "published" | "skipped" | "failed"
  scheduledJobId String? // FK to PostJob.id (set when scheduled, nullable)
  publishedAt    String? // ISO string — when the PostJob finished

  // Error tracking
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([libraryId, status])
  @@index([libraryId, order])
  @@index([workspaceId])
  @@index([status])
}

model OAuthClient {
  id           String   @id // the client_id we issued
  clientName   String
  redirectUris Json // String[]
  createdAt    DateTime @default(now())
}
